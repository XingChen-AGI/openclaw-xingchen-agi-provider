{
  "name": "@xingchen-agi/xingchen-agi-provider",
  "version": "1.0.0",
  "description": "XingChen-AGI provider for the Xing4.1-Preview model.",
  "type": "module",
  "license": "MIT-0",
  "repository": {
    "type": "git",
    "url": "https://github.com/XingChen-AGI/openclaw-xingchen-agi-provider"
  },
  "files": [
    "dist/",
    "assets/",
    "openclaw.plugin.json",
    "index.ts",
    "README.md"
  ],
  "scripts": {
    "build": "esbuild index.ts --bundle --platform=node --format=esm --external:openclaw/* --outfile=dist/index.js"
  },
  "peerDependencies": {
    "openclaw": ">=2026.11.3"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "clawhubSpec": "clawhub:@xingchen-agi/xingchen-agi-provider",
      "defaultChoice": "clawhub",
      "minHostVersion": ">=2026.11.3"
    },
    "compat": {
      "pluginApi": ">=2026.11.3"
    },
    "build": {
      "openclawVersion": "2026.11.3"
    }
  }
}